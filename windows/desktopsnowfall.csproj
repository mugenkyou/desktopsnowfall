<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>desktopsnowfall</AssemblyName>
    <RootNamespace>desktopsnowfall</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Version shown in the tray menu and the exe's Properties; the release workflow sets it from the git tag -->
    <Version>1.1.2</Version>
    <Product>desktopsnowfall</Product>
    <Company>mugenkyou</Company>
    <Description>Snow on your desktop</Description>
    <Copyright>Copyright (c) 2026 mugenkyou</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
  </ItemGroup>

</Project>
